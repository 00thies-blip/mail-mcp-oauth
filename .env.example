# mail-mcp-oauth — environment configuration
# Copy to .env for local reference only; on Render these are set in the
# service's Environment tab, not in a committed file.

# --- Server ---
# Render sets PORT itself; HOST must be 0.0.0.0 to be reachable.
HOST=0.0.0.0
PORT=3220
# The public HTTPS URL Claude.ai will use to reach this server. Must match
# your custom domain exactly (used in OAuth discovery + redirects).
PUBLIC_URL=https://mcp-mail.lukasthies.com
LOG_LEVEL=info

# --- Accounts ---
# The entire accounts.json payload as a single-line JSON string. See
# docs/ACCOUNTS.md for the schema and per-provider settings.
ACCOUNTS_JSON={"version":1,"accounts":[]}

# --- OAuth 2.1 login gate ---
# Shown on the /authorize login page when Claude.ai connects. Pick your own
# values — this is the only thing standing between the internet and your
# inboxes, so use a strong, unique password.
OAUTH_USER=
OAUTH_PASS=

# Symmetric secret used to sign access/refresh tokens and short-lived login
# tickets (HS256 JWT). Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Sending ---
# Render's free tier blocks outbound SMTP ports (25/465/587) entirely, so
# send_message routes through Brevo's HTTPS API instead when this is set.
# Leave empty to send via direct SMTP (works on a VPS / paid Render plan).
# See docs/ACCOUNTS.md#sending-brevo-instead-of-direct-smtp.
BREVO_API_KEY=
